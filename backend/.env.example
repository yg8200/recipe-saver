# Copy this file to .env and fill in your own keys. Never commit the real .env.

# Required
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the models (defaults shown)
# AI_MODEL_NAME=gpt-4o-mini            # fallback model for every OpenAI call
# OPENAI_EXTRACTOR_MODEL=              # website extraction
# OPENAI_CORRECTOR_MODEL=              # photo typo correction
# OPENAI_YOUTUBE_MODEL=                # YouTube extraction (default gpt-4o)
# GEMINI_MODEL_NAME=gemini-3.8-flash   # photo OCR
# GEMINI_THINKING_LEVEL=LOW            # LOW is faster; DEFAULT keeps the model's own setting

# Optional: use any OpenAI-compatible provider instead of OpenAI
# AI_API_KEY=
# AI_BASE_URL=

# Optional: only needed outside Docker or in production
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipe_saver
# SECRET_KEY=
# FLASK_ENV=development
