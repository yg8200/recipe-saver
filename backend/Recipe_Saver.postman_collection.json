        {
          "name": "Add Recipe (Manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes"
              ]
            },
            "description": "Create a recipe manually. `title`, `ingredients` and `instructions` are required; the time/servings fields must be non-negative integers or null. Returns 409 if the title exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Classic Shakshuka\",\n  \"ingredients\": [\n    \"4 eggs\",\n    \"4 ripe tomatoes\",\n    \"1 red bell pepper\",\n    \"2 cloves garlic\",\n    \"1 tsp cumin\",\n    \"2 tbsp olive oil\"\n  ],\n  \"instructions\": [\n    \"Saute peppers and garlic.\",\n    \"Add tomatoes and simmer until thick.\",\n    \"Crack eggs and cook until whites set.\"\n  ],\n  \"prep_time_minutes\": 10,\n  \"cook_time_minutes\": 20,\n  \"servings\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 or 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('recipeId', pm.response.json().id);",
                  "    console.log('Saved recipeId =', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
