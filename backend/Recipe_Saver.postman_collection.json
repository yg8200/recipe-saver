    {
      "name": "AI Extraction",
      "item": [
        {
          "name": "Extract from Website URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recipes/extract",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes",
                "extract"
              ]
            },
            "description": "Scrape a recipe web page and extract it with OpenAI, then save it.\n\nIf the page declares a main image (recipe JSON-LD or og:image) it is downloaded and saved as the dish photo (`image_url`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://sallysbakingaddiction.com/easy-homemade-soft-pretzels/\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 or 400 or 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('recipeId', pm.response.json().id);",
                  "    console.log('Saved recipeId =', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Extract from YouTube Video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
