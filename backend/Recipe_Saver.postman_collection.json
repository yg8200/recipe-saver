{
  "info": {
    "name": "Recipe Saver API",
    "_postman_id": "7d9e4a3b-18f2-491c-b3a1-7c5f891b9201",
    "description": "All endpoints of the local Recipe Saver backend.\n\n- `baseUrl` defaults to http://127.0.0.1:5001 (change it under the collection's Variables tab).\n- Every request that creates a recipe (manual, URL, YouTube, image) saves the new id into `recipeId`, so Get / Update / Delete act on the last recipe you created.\n- Titles are unique: creating the same recipe twice returns 409. Delete it first or change the title.\n- The Folders group saves the id of the folder you create into `folderId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001"
    },
    {
      "key": "recipeId",
      "value": "1"
    },
    {
      "key": "folderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Check that the server is up."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
