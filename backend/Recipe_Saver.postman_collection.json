              ]
            },
            "description": "Extract a recipe from a YouTube video (watch, youtu.be, shorts, embed and live links work). Uses the description first; the transcript is only used to fill in missing parts.\n\nReplace VIDEO_ID with a real cooking video before sending.\n\nThe video thumbnail is saved as the dish photo (`image_url`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.youtube.com/watch?v=VIDEO_ID\"\n}",
              "options": {
                "raw": {
